# Required in production (e.g. Vercel) — without it, data and sessions
# reset on every cold start. Optional for local dev (falls back to a JSON
# file in data/ and file-based sessions).
DATABASE_URL=

# Long random string. Without it, sessions won't survive cold starts on
# serverless platforms.
SESSION_SECRET=

# Long random string. Required to call the /api/cron/agents-tick endpoint
# that Vercel Cron uses to run the background agents on a schedule.
CRON_SECRET=

# Optional — enables AI-drafted agent output instead of templated text.
ANTHROPIC_API_KEY=
